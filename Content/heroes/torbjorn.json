{
  "id": "torbjorn",
  "name": "Torbjörn",
  "role": "damage",
  "guide": [
    {
      "title": "Aufgabe",
      "rules": [
        {
          "text": "Mittlere Distanz und sehr flexibel. Stark im Duell aber nur mit Overload.",
          "videos": [
            {
              "label": "Masters 0:00",
              "url": "https://www.youtube.com/watch?v=Fy6n5gvYTjY&t=0s"
            }
          ]
        },
        {
          "text": "300 HP plus Overload: Du hältst Lanes und Räume, die anderen DPS zu riskant sind. Deine Lebenspunkte sind deine Mobilität.",
          "videos": [
            {
              "label": "Gold 3:00",
              "url": "https://www.youtube.com/watch?v=EhzSArLzaMc&t=180s"
            },
            {
              "label": "GM 27:30",
              "url": "https://www.youtube.com/watch?v=s_Na9l95B5M&t=1650s"
            }
          ]
        }
      ]
    },
    {
      "title": "Positionierung",
      "rules": [
        {
          "text": "Ecke halten, nicht ins Offene laufen. Deine Winkel scheitern meist dann, wenn du nach vorn gehst.",
          "videos": [
            {
              "label": "Gold 40:30",
              "url": "https://www.youtube.com/watch?v=EhzSArLzaMc&t=2430s"
            },
            {
              "label": "Gold 43:00",
              "url": "https://www.youtube.com/watch?v=EhzSArLzaMc&t=2580s"
            }
          ]
        },
        {
          "text": "Nie zweimal am selben Fleck peeken: andere Seite der Kante, ducken, höher oder die nächste Ecke derselben Lane. Der Turret hält die alte Ecke.",
          "videos": [
            {
              "label": "GM 52:00",
              "url": "https://www.youtube.com/watch?v=s_Na9l95B5M&t=3120s"
            }
          ]
        },
        {
          "text": "Auch mit Overload nicht im Offenen stehen und alles einstecken.",
          "videos": [
            {
              "label": "Masters 28:00",
              "url": "https://www.youtube.com/watch?v=Fy6n5gvYTjY&t=1680s"
            }
          ]
        },
        {
          "text": "Lane halten. Nach Overload nicht quer durchs Offene einem Kill hinterherlaufen.",
          "videos": [
            {
              "label": "Gold 10:30",
              "url": "https://www.youtube.com/watch?v=EhzSArLzaMc&t=630s"
            }
          ]
        },
        {
          "text": "Nicht mit dem Team auf einem Fleck stehen. Team auf Main → du auf die Seite.",
          "videos": [
            {
              "label": "Gold 14:30",
              "url": "https://www.youtube.com/watch?v=EhzSArLzaMc&t=870s"
            },
            {
              "label": "Gold 35:00",
              "url": "https://www.youtube.com/watch?v=EhzSArLzaMc&t=2100s"
            }
          ]
        },
        {
          "text": "Lane genommen → dort bleiben, statt wieder von der längsten Sichtlinie zu spammen.",
          "videos": [
            {
              "label": "GM 13:00",
              "url": "https://www.youtube.com/watch?v=s_Na9l95B5M&t=780s"
            }
          ]
        },
        {
          "text": "Früh da sein. Dieselbe Lane ist 8–10 s später viel schwerer zu nehmen.",
          "videos": [
            {
              "label": "GM 23:00",
              "url": "https://www.youtube.com/watch?v=s_Na9l95B5M&t=1380s"
            }
          ]
        }
      ]
    },
    {
      "title": "Kit · Turret",
      "rules": [
        {
          "text": "Drei Arten: vor dem Fight auf einem anderen Winkel aufbauen · halb aufbauen, wenn die Zeit fehlt · als Ablenkung hinwerfen, wenn du gedivet wirst.",
          "videos": [
            {
              "label": "GM 2:00",
              "url": "https://www.youtube.com/watch?v=s_Na9l95B5M&t=120s"
            }
          ]
        },
        {
          "text": "Später Wert schlägt frühen. Ein Turret, der erst mitten im Fight schießt, kostet den Gegner mehr als einer, der sofort zerstört wird.",
          "videos": [
            {
              "label": "Masters 2:30",
              "url": "https://www.youtube.com/watch?v=Fy6n5gvYTjY&t=150s"
            },
            {
              "label": "Gold 6:30",
              "url": "https://www.youtube.com/watch?v=EhzSArLzaMc&t=390s"
            }
          ]
        },
        {
          "text": "Erst scouten. Ohne Info den Turret behalten, sonst wartest du lange auf den Cooldown.",
          "videos": [
            {
              "label": "Masters 6:00",
              "url": "https://www.youtube.com/watch?v=Fy6n5gvYTjY&t=360s"
            }
          ]
        },
        {
          "text": "Weg von dir, hinter Ecken. Der Gegner muss sich zwischen dir und ihm entscheiden.",
          "videos": [
            {
              "label": "Gold 7:58",
              "url": "https://www.youtube.com/watch?v=EhzSArLzaMc&t=478s"
            },
            {
              "label": "Gold 26:00",
              "url": "https://www.youtube.com/watch?v=EhzSArLzaMc&t=1560s"
            }
          ]
        },
        {
          "text": "Fight zieht weiter → Turret behalten, statt ihn irgendwo hinzuwerfen.",
          "videos": [
            {
              "label": "Masters 15:30",
              "url": "https://www.youtube.com/watch?v=Fy6n5gvYTjY&t=930s"
            }
          ]
        }
      ]
    },
    {
      "title": "Kit · Overload",
      "rules": [
        {
          "text": "Overload ist Leben, nicht Feuerrate. Im Duell weiter langsam schießen; volle Feuerrate nur gegen Tank, Schild oder Engstelle.",
          "videos": [
            {
              "label": "GM 11:30",
              "url": "https://www.youtube.com/watch?v=s_Na9l95B5M&t=690s"
            },
            {
              "label": "Masters 8:00",
              "url": "https://www.youtube.com/watch?v=Fy6n5gvYTjY&t=480s"
            }
          ]
        },
        {
          "text": "Zwei Arten: gezielt für Schaden (dann musst du treffen) oder als Versicherung fürs Duell.",
          "videos": [
            {
              "label": "Masters 9:11",
              "url": "https://www.youtube.com/watch?v=Fy6n5gvYTjY&t=551s"
            }
          ]
        },
        {
          "text": "Schon im Spawn zünden für mehr Tempo – er ist wieder bereit, wenn du ankommst.",
          "videos": [
            {
              "label": "Masters 33:30",
              "url": "https://www.youtube.com/watch?v=Fy6n5gvYTjY&t=2010s"
            }
          ]
        }
      ]
    },
    {
      "title": "Kit · Aim",
      "rules": [
        {
          "text": "Auf Kopfhöhe zielen. Das Projektil ist langsam, also muss jeder Treffer zählen. Auf Distanz etwas über den Kopf.",
          "videos": [
            {
              "label": "Masters 11:30",
              "url": "https://www.youtube.com/watch?v=Fy6n5gvYTjY&t=690s"
            }
          ]
        },
        {
          "text": "Langsam schießen. Torb gewinnt Duelle durch Treffen, nicht durch Ausweichen. Lange Seitwärtsbewegungen statt hektischem A-D.",
          "videos": [
            {
              "label": "Masters 30:00",
              "url": "https://www.youtube.com/watch?v=Fy6n5gvYTjY&t=1800s"
            },
            {
              "label": "GM 18:00",
              "url": "https://www.youtube.com/watch?v=s_Na9l95B5M&t=1080s"
            }
          ]
        },
        {
          "text": "Schrotflinte nur aus der Nähe, der Schaden fällt stark ab. Hammer nur mit dem Tempo-Perk.",
          "videos": [
            {
              "label": "Gold 21:30",
              "url": "https://www.youtube.com/watch?v=EhzSArLzaMc&t=1290s"
            },
            {
              "label": "Gold 4:00",
              "url": "https://www.youtube.com/watch?v=EhzSArLzaMc&t=240s"
            }
          ]
        },
        {
          "text": "Übung: Deathmatch, nur Primärfeuer, jeden Schuss einzeln zielen. Gewinnen ist egal.",
          "videos": [
            {
              "label": "Gold 22:00",
              "url": "https://www.youtube.com/watch?v=EhzSArLzaMc&t=1320s"
            },
            {
              "label": "Gold 43:30",
              "url": "https://www.youtube.com/watch?v=EhzSArLzaMc&t=2610s"
            }
          ]
        }
      ]
    },
    {
      "title": "Kit · Molten Core",
      "rules": [
        {
          "text": "Erste Ult früh einsetzen. Sie schafft Platz und ist fast nie verschwendet.",
          "videos": [
            {
              "label": "Masters 17:00",
              "url": "https://www.youtube.com/watch?v=Fy6n5gvYTjY&t=1020s"
            },
            {
              "label": "GM 59:00",
              "url": "https://www.youtube.com/watch?v=s_Na9l95B5M&t=3540s"
            }
          ]
        },
        {
          "text": "Vom Winkel aus, breit verteilen, Abpraller nutzen. Ziel ist Raum, nicht ein Kill.",
          "videos": [
            {
              "label": "Masters 16:30",
              "url": "https://www.youtube.com/watch?v=Fy6n5gvYTjY&t=990s"
            },
            {
              "label": "GM 25:00",
              "url": "https://www.youtube.com/watch?v=s_Na9l95B5M&t=1500s"
            }
          ]
        }
      ]
    },
    {
      "title": "Matchups",
      "rules": [
        {
          "text": "Sojourn: auf Distanz im Offenen kaum zu schlagen, auf 10–15 m leicht. Über Räume nah rangehen, nicht auf langer Linie peeken.",
          "videos": [
            {
              "label": "GM 9:30",
              "url": "https://www.youtube.com/watch?v=s_Na9l95B5M&t=570s"
            },
            {
              "label": "GM 24:00",
              "url": "https://www.youtube.com/watch?v=s_Na9l95B5M&t=1440s"
            }
          ]
        },
        {
          "text": "Widow, Freja, Ana auf offenen Maps: nicht aus der Ferne duellieren, sondern einen Raum kontrollieren.",
          "videos": [
            {
              "label": "GM 38:00",
              "url": "https://www.youtube.com/watch?v=s_Na9l95B5M&t=2280s"
            }
          ]
        },
        {
          "text": "Junkrat im kleinen Raum: nicht hineingehen, eine andere Lane nehmen.",
          "videos": [
            {
              "label": "GM 23:00",
              "url": "https://www.youtube.com/watch?v=s_Na9l95B5M&t=1380s"
            }
          ]
        },
        {
          "text": "Genji, Tracer, Dive-DPS: Du bist im Vorteil. Mit Overload dagegenhalten, der Turret ist ihr zweites Problem.",
          "videos": [
            {
              "label": "GM 3:30",
              "url": "https://www.youtube.com/watch?v=s_Na9l95B5M&t=210s"
            },
            {
              "label": "GM 56:00",
              "url": "https://www.youtube.com/watch?v=s_Na9l95B5M&t=3360s"
            }
          ]
        }
      ]
    }
  ],
  "path": [
